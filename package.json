{
  "name": "@autoais/agent-lark-ease",
  "version": "0.8.1",
  "description": "Agent Ease for Lark — bridge Feishu/Lark messenger with local Claude Code or Codex CLI agents",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AutoAIs/agent-lark-ease.git"
  },
  "bugs": {
    "url": "https://github.com/AutoAIs/agent-lark-ease/issues"
  },
  "homepage": "https://github.com/AutoAIs/agent-lark-ease#readme",
  "bin": {
    "agent-lark-ease": "./bin/agent-lark-ease.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build:web": "vite build web",
    "build:dts": "rolldown -c rolldown.dts.config.ts",
    "build": "pnpm build:web && tsup && pnpm build:dts",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm build:web",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:process": "vitest run tests/process --passWithNoTests",
    "ci:local": "git diff --check && pnpm test && pnpm typecheck && pnpm build",
    "ci:platform": "pnpm test && pnpm typecheck && pnpm build",
    "prepare": "npm run build",
    "prepublishOnly": "pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@larksuite/channel": "^0.7.1",
    "commander": "^15.1.0",
    "cross-spawn": "^7.0.6",
    "graceful-fs": "^4.2.11",
    "proper-lockfile": "^4.1.2",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/cross-spawn": "^6.0.6",
    "@types/graceful-fs": "^4.1.9",
    "@types/node": "^26.6.6",
    "@types/proper-lockfile": "^4.1.4",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rolldown": "^1.3.0",
    "rolldown-plugin-dts": "0.30.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "agent-lark-ease",
    "feishu",
    "lark",
    "claude",
    "claude-code",
    "codex",
    "cli",
    "channel",
    "bridge"
  ],
  "license": "MIT"
}
